{
  "name": "ml-study-guide",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Interactive machine learning study guide (Weeks 1–4: regression, classification, Bayesian classification, tree learning)",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview"
  },
  "dependencies": {
    "@mdx-js/react": "^3.1.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "katex": "^0.19.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@types/katex": "^0.16.8",
    "@types/mdx": "^2.0.14",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "acorn": "^8.19.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "overrides": {
    "micromark-extension-math": {
      "katex": "$katex"
    }
  }
}
